###################################################################
# SonarQube 部署环境变量
# 使用方法：复制本文件为 .env 后修改（cp .env.example .env）
# 注意：生产环境请务必修改 POSTGRES_PASSWORD 等敏感信息
###################################################################

# SonarQube 镜像版本社区版（LTS 10.6；商业版可将 community 换成 developer/enterprise）
SONAR_VERSION=10.6.0-community

# SonarQube Web 对外访问端口
SONAR_WEB_PORT=9000

# PostgreSQ L版本
POSTGRES_VERSION=15

# PostgreSQL 对外映射端口（仅内网/本机调试可暴露，生产建议注释掉 ports）
POSTGRES_PORT=5432

# 数据库连接信息（SonarQube 与 PostgreSQL 均使用）
POSTGRES_DB=sonar
POSTGRES_USER=sonar
POSTGRES_PASSWORD=sonar@2026

# 时区
TZ=Asia/Shanghai

# JVM 内存配置，建议 Web/Search 各 1/4 物理内存，最小机器内存要求 4GB 以上
SONAR_WEB_JAVA_OPTS=-Xmx2048m -Xms2048m
SONAR_SEARCH_JAVA_OPTS=-Xmx2048m -Xms2048m
SONAR_CE_JAVA_OPTS=-Xmx1024m -Xms1024m