# {{ ansible_managed | default('Ansible managed') }}
# nvm —— Node Version Manager
# 由 install_nvm role 生成，多用户共享配置
#
# 用法：
#   source /etc/profile.d/nvm.sh   （登录 shell 会自动加载）
#   nvm install 22
#   nvm use 22
#   nvm alias default 22

export NVM_DIR="{{ nvm_prefix }}"
{% if nvm_nodejs_org_mirror | default('') | length > 0 %}
# Node 二进制下载源（国内镜像可显著提速）
export NVM_NODEJS_ORG_MIRROR="{{ nvm_nodejs_org_mirror }}"
{% endif %}
{% for k, v in (nvm_runtime_env | default({})).items() %}
{% if v | default('') | string | length > 0 %}
export {{ k }}="{{ v }}"
{% endif %}
{% endfor %}

# 加载 nvm
if [ -s "${NVM_DIR}/nvm.sh" ]; then
    # shellcheck source=/dev/null
    . "${NVM_DIR}/nvm.sh"
    # shellcheck source=/dev/null
    [ -s "${NVM_DIR}/bash_completion" ] && . "${NVM_DIR}/bash_completion"
{% if nvm_autoload | bool %}
    # 默认工具链：nvm 的 "default" 别名指向哪个版本就激活哪个。
    # 用 2>/dev/null 静默，避免尚未安装任何 Node 版本时干扰交互。
    nvm use default >/dev/null 2>&1 || true
{% endif %}
fi
